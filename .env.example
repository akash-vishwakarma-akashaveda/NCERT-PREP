# Firebase Web App Configuration
# Replace these with your Firebase project credentials from console.firebase.google.com
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Firebase Analytics (Project settings → General → your web app → measurementId)
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Region the Cloud Functions are deployed to
VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# App Check (NFR-3): reCAPTCHA v3 site key registered in Firebase Console → App Check
VITE_RECAPTCHA_V3_SITE_KEY=your-recaptcha-v3-site-key
# Local development only: debug token registered in App Check → Manage debug tokens
VITE_APPCHECK_DEBUG_TOKEN=
