rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Videos collection: Public read, writes allowed by admin
    match /videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users collection: owner read/write, but `role` is only assignable by an admin
    // (Firebase Console / Admin SDK), never self-assigned by a student.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin() || (isOwner(userId) && !('role' in request.resource.data));
      allow update: if isAdmin() || (isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isOwner(userId) || isAdmin();

      // User progress subcollection: Owner-only read/write
      match /user_progress/{videoId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Feedback: created only by the rate-limited submitFeedback Cloud Function (Admin SDK).
    // Students can neither read nor write directly; admins review and update status.
    match /feedback/{feedbackId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // Curriculum hierarchy managed in the admin dashboard; everyone can browse it.
    match /classes/{classId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /chapters/{chapterId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Notes & cheat sheets: published notes are public, drafts are admin-only.
    // `resource == null` lets a lookup for a chapter without notes return "not found" instead of an error.
    match /notes/{noteId} {
      allow get: if resource == null || resource.data.isPublished == true || isAdmin();
      allow list: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }

    // Doubts: created only by the rate-limited askDoubt Cloud Function.
    // The asking student can read theirs and may only mark a reply as seen or close the doubt.
    match /doubts/{doubtId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if false;
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['student_unread', 'status', 'updated_at']) &&
        request.resource.data.student_unread == false &&
        (request.resource.data.status == resource.data.status || request.resource.data.status == 'closed')
      );
      allow delete: if isAdmin();
    }

    // rate_limits is server-only (no client access); covered by the default deny.
  }
}
